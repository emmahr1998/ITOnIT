# Base URL of the ITOnIT FastAPI backend, no trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# Leave unset (or "web") for the browser build. The Electron desktop build
# (see frontend/.env.desktop and desktop/) sets this to "desktop", which
# changes two things: "/" redirects to the company login instead of the public
# site, and the login screen remembers the last-used company code in
# localStorage (surviving app restarts) instead of sessionStorage (cleared when
# the tab closes).
# VITE_APP_MODE=desktop
