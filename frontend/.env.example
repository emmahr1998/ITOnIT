# Base URL of the ITOnIT FastAPI backend, no trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# Leave unset (or "web") for the browser build. The future Electron build
# sets this to "desktop", which changes only one thing today: the login
# screen remembers the last-used company code in localStorage (surviving
# app restarts) instead of sessionStorage (cleared when the tab closes).
# VITE_APP_MODE=desktop
