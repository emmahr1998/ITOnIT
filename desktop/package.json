{
  "name": "itonit-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Thin Electron shell for the ITOnIT React frontend",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron . --prod",
    "build:renderer": "npm --prefix ../frontend run build:desktop",
    "dist": "npm run build:renderer && electron-builder --win nsis portable --x64",
    "dist:dir": "npm run build:renderer && electron-builder --win dir --x64"
  },
  "build": {
    "appId": "com.itonit.desktop",
    "productName": "ITOnIT",
    "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist-desktop",
        "to": "renderer"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../frontend/public/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  }
}
