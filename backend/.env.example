APP_NAME=ITOnIT API
APP_VERSION=1.0.0

# SQL Server connection
DATABASE_SERVER=localhost\SQLEXPRESS
DATABASE_NAME=ITOnIT
DATABASE_DRIVER=ODBC Driver 17 for SQL Server
# Leave DATABASE_USERNAME/DATABASE_PASSWORD unset to use Windows Trusted Connection
DATABASE_USERNAME=
DATABASE_PASSWORD=

# JWT
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: seeds one initial admin user when running
#   python -m app.scripts.seed_initial_data
# Leave blank to skip admin creation (roles are always seeded regardless).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=
INITIAL_ADMIN_LAST_NAME=
