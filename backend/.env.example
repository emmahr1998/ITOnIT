APP_NAME=ITOnIT API
APP_VERSION=1.0.0

# SQL Server connection
DATABASE_SERVER=localhost\SQLEXPRESS
DATABASE_NAME=ITOnIT
DATABASE_DRIVER=ODBC Driver 17 for SQL Server
# Leave DATABASE_USERNAME/DATABASE_PASSWORD unset to use Windows Trusted Connection
DATABASE_USERNAME=
DATABASE_PASSWORD=

# JWT (used once authentication is implemented)
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
