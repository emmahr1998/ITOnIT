APP_NAME=ITOnIT API
APP_VERSION=1.0.0

# SQL Server connection
DATABASE_SERVER=localhost\SQLEXPRESS
DATABASE_NAME=ITOnIT
DATABASE_DRIVER=ODBC Driver 17 for SQL Server
# Leave DATABASE_USERNAME/DATABASE_PASSWORD unset to use Windows Trusted Connection
DATABASE_USERNAME=
DATABASE_PASSWORD=

# JWT
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Optional: seeds one initial admin user when running
#   python -m app.scripts.seed_initial_data
# Leave blank to skip admin creation (roles are always seeded regardless).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=
INITIAL_ADMIN_LAST_NAME=

# Optional: bootstraps the one platform-level System Administrator account
# (POST /platform/login) when running the same seed_initial_data script.
# Leave blank to skip - roles are always seeded regardless, but no platform
# account exists until these are set and the script is run.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_FIRST_NAME=
PLATFORM_ADMIN_LAST_NAME=

# Attachments
ATTACHMENT_STORAGE_PATH=storage/attachments
MAX_ATTACHMENT_SIZE_BYTES=10485760

# CORS: browser origins allowed to call this API (JSON array). Add your
# production frontend's URL here before deploying. To also serve the Electron
# desktop app (see desktop/), add its exact origin "app://itonit" - never "*"
# or "null":
#   CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","app://itonit"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional: sends the "here's your company code" email after public company
# registration (Gmail-compatible SMTP, see app/services/email_service.py).
# Leave SMTP_USERNAME/SMTP_PASSWORD/SMTP_FROM_EMAIL blank to skip sending
# entirely - registration still succeeds normally either way.
# SMTP_PASSWORD must be a Gmail "App Password" (Google Account > Security >
# App Passwords, requires 2-Step Verification) - never your real account
# password, and never commit a real value here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ITOnIT

# Optional: destination address for the public Help Center contact form
# (POST /support/contact). Reuses the SMTP settings above. Leave blank to
# have the contact form return a safe "try again later" error instead of
# silently failing.
SUPPORT_EMAIL=
